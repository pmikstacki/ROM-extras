#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "$0")/.."
: "${ROM_EXTRAS_PYTHON:?Explicit Python 3 executable required}"
: "${ROM_EXTRAS_OTEL_NATIVE_FIXTURE:?Select an owned isolated TLS/auth Collector fixture}"
: "${ROM_EXTRAS_OTEL_NATIVE_CONTAINER:?Select its owned native container}"
"$ROM_EXTRAS_PYTHON" tests/fixture-processes/test_owned_process.py
cargo test --locked -p rom-opentelemetry --features trace
cargo clippy --locked -p rom-opentelemetry --all-targets --all-features -- -D warnings
cargo fmt --manifest-path tests/opentelemetry-native-consumer/Cargo.toml -- --check
cargo clippy --manifest-path tests/opentelemetry-native-consumer/Cargo.toml --locked --offline --target-dir target/opentelemetry-native-consumer --all-targets -- -D warnings
"$ROM_EXTRAS_PYTHON" scripts/check-opentelemetry-native.py
cargo package --allow-dirty --locked --no-verify -p rom-opentelemetry \
    --config 'patch.crates-io.rom.git="https://github.com/pmikstacki/ROM"' \
    --config 'patch.crates-io.rom.rev="d7ef529040eec60dc869034c2d33130219db85fe"'
consumer=$(node scripts/prepare-opentelemetry-native-package.mjs)
cargo clippy --manifest-path "$consumer/Cargo.toml" --offline --target-dir target/opentelemetry-native-packaged-consumer --all-targets -- -D warnings
ROM_EXTRAS_OTEL_PACKAGED_MANIFEST="$consumer/Cargo.toml" "$ROM_EXTRAS_PYTHON" scripts/check-opentelemetry-native.py
