#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "$0")/.."
projection_python="${ROM_EXTRAS_PYTHON:-python3}"
if ! command -v "$projection_python" >/dev/null; then
    echo 'Python 3 is required; set ROM_EXTRAS_PYTHON to its executable path.' >&2
    exit 2
fi
export PYTHONDONTWRITEBYTECODE=1
"$projection_python" tests/projection-probes/probe_transport_test.py
"$projection_python" tests/projection-probes/qdrant_fence.py
"$projection_python" tests/projection-probes/qdrant_faults.py
"$projection_python" tests/projection-probes/opensearch_fence.py
