#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "$0")/.."
umask 077
: "${ROM_EXTRAS_KEYCLOAK_FIXTURE:?Explicit private controlled Keycloak fixture directory required.}"
: "${ROM_EXTRAS_PYTHON:?Python runtime required.}"
command -v timeout >/dev/null
export CARGO_INCREMENTAL=0
"$ROM_EXTRAS_PYTHON" -m unittest discover -s tests/oidc-host -p 'test_*.py'
cargo test --locked -p rom-oidc-presets
cargo clippy --locked -p rom-oidc-presets --all-targets -- -D warnings
RUSTDOCFLAGS='-D warnings' cargo doc --locked -p rom-oidc-presets --no-deps
manifest=tests/oidc-native-consumer/Cargo.toml
cargo fmt --manifest-path "$manifest" -- --check
cargo clippy --locked --offline --manifest-path "$manifest" --target-dir target --all-targets -- -D warnings
cargo build --locked --offline --manifest-path "$manifest" --target-dir target
mkdir -p .superpowers/oidc-native-runs
run_consumer() {
    local run
    run=$(mktemp -d "$PWD/.superpowers/oidc-native-runs/run-XXXXXXXX")
    timeout 150 "$ROM_EXTRAS_PYTHON" tests/oidc-host/qualify.py "$ROM_EXTRAS_KEYCLOAK_FIXTURE" "$1" "$run" > "$run/protocol.log" 2>&1
    printf 'Native OIDC qualification passed; retained evidence: %s\n' "$run"
}
run_consumer "$PWD/target/debug/rom-oidc-native-consumer"
cargo package --locked --allow-dirty --no-verify -p rom-oidc-presets --config 'patch.crates-io.rom-auth.git="https://github.com/pmikstacki/ROM"' --config 'patch.crates-io.rom-auth.rev="d7ef529040eec60dc869034c2d33130219db85fe"'
node --check scripts/prepare-oidc-native-package.mjs
consumer=$(node scripts/prepare-oidc-native-package.mjs)
cargo clippy --manifest-path "$consumer/Cargo.toml" --locked --offline --target-dir target --all-targets -- -D warnings
cargo build --manifest-path "$consumer/Cargo.toml" --locked --offline --target-dir target
run_consumer "$PWD/target/debug/rom-oidc-native-packaged-consumer"
