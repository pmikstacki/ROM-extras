#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "$0")/.."
: "${ROM_EXTRAS_OPENBAO_ENDPOINT:?Set the real OpenBao fixture endpoint.}"
: "${ROM_EXTRAS_OPENBAO_CA:?Set the private fixture CA.}"
: "${ROM_EXTRAS_OPENBAO_TOKEN:?Set the limited fixture token.}"
: "${ROM_EXTRAS_OPENBAO_MARKERS:?Set the private expected-material file.}"
: "${ROM_EXTRAS_KMS_MIGRATION_EVIDENCE:?Set the private retained migration evidence directory.}"
rustfmt --edition 2024 --check tests/packaged-secrets/main.rs crates/rom-openbao/tests/fixture/migration.rs
node --check scripts/prepare-secrets-package.mjs
cargo package --allow-dirty --locked --no-verify -p rom-secrets -p rom-kms -p rom-openbao \
    --config 'patch.crates-io.rom-secrets.path="crates/rom-secrets"' \
    --config 'patch.crates-io.rom-kms.path="crates/rom-kms"'
package_consumer=$(node scripts/prepare-secrets-package.mjs)
cargo run --manifest-path "$package_consumer/Cargo.toml" --offline \
    --target-dir target/secrets-packaged-consumer
cargo clippy --manifest-path "$package_consumer/Cargo.toml" --locked --offline \
    --target-dir target/secrets-packaged-consumer --all-targets -- -D warnings

# Compile every archived service test target without relying on source-tree test files.
package_root=$(dirname -- "$package_consumer")
cargo test --manifest-path "$package_root/rom-openbao-0.1.0-dev/Cargo.toml" --offline \
    --features service-fixture --test service --no-run --target-dir target/secrets-packaged-consumer \
    --config "patch.crates-io.rom-secrets.path=\"$package_root/rom-secrets-0.1.0-dev\"" \
    --config "patch.crates-io.rom-kms.path=\"$package_root/rom-kms-0.1.0-dev\""
