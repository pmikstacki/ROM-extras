#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "$0")/.."
source ./scripts/map-fixture-tls.sh
rom_map_fixture_tls
cargo test --locked -p rom-map-http -p rom-nominatim -p rom-osrm -p rom-configured-maps -p rom-maptiler --features controlled-fixture
cargo clippy --locked -p rom-map-http -p rom-nominatim -p rom-osrm -p rom-configured-maps -p rom-maptiler --all-targets --features controlled-fixture -- -D warnings
cargo fmt --manifest-path tests/map-adapter-consumer/Cargo.toml -- --check
cargo build --manifest-path tests/map-adapter-consumer/Cargo.toml --locked --offline --target-dir target/map-adapter-consumer
node scripts/check-map-adapter-consumer.mjs
cargo clippy --manifest-path tests/map-adapter-consumer/Cargo.toml --locked --offline --target-dir target/map-adapter-consumer --all-targets -- -D warnings

cargo fmt --manifest-path tests/osrm-public-consumer/Cargo.toml -- --check
cargo build --manifest-path tests/osrm-public-consumer/Cargo.toml --locked --offline --target-dir target/osrm-public-consumer
cargo clippy --manifest-path tests/osrm-public-consumer/Cargo.toml --locked --offline --target-dir target/osrm-public-consumer --all-targets -- -D warnings

cargo fmt --manifest-path tests/configured-map-consumer/Cargo.toml -- --check
cargo run --manifest-path tests/configured-map-consumer/Cargo.toml --locked --offline --target-dir target/configured-map-consumer
cargo clippy --manifest-path tests/configured-map-consumer/Cargo.toml --locked --offline --target-dir target/configured-map-consumer --all-targets -- -D warnings
if [[ -n "${ROM_EXTRAS_MAP_METADATA_ENDPOINT:-}${ROM_EXTRAS_MAP_METADATA_CA:-}" ]]; then
    : "${ROM_EXTRAS_MAP_METADATA_ENDPOINT:?explicit controlled metadata endpoint required}"
    : "${ROM_EXTRAS_MAP_METADATA_CA:?explicit controlled metadata CA required}"
    target/configured-map-consumer/debug/rom-configured-map-consumer "$ROM_EXTRAS_MAP_METADATA_ENDPOINT" "$ROM_EXTRAS_MAP_METADATA_CA"
fi

cargo fmt --manifest-path tests/maptiler-public-consumer/Cargo.toml -- --check
cargo build --manifest-path tests/maptiler-public-consumer/Cargo.toml --locked --offline --target-dir target/maptiler-public-consumer
node scripts/check-map-adapter-consumer.mjs maptiler
cargo clippy --manifest-path tests/maptiler-public-consumer/Cargo.toml --locked --offline --target-dir target/maptiler-public-consumer --all-targets -- -D warnings

./scripts/check-map-host

./scripts/check-map-live-host
